/* ===== v1.4: خوانایی عدد پمپ بنزین و مشخصات خودرو ===== */
.dispenser input{font-family:inherit!important;font-size:28px!important;font-weight:800!important;letter-spacing:0!important;direction:ltr;text-align:center;color:#d6ff5c!important;text-shadow:0 0 5px rgba(198,255,61,.35)!important;font-variant-numeric:tabular-nums}
.dispenser input::placeholder{color:#59702e!important;font-weight:600}
.fuel-step{font-family:inherit!important;font-size:14px!important;font-weight:800;color:#e4ff8a!important;line-height:1.2}
.dispenser-label{font-size:12.5px!important;color:#b8d2c8!important}
.fuel-stat-card strong,#fuel-stat{font-size:13px!important;white-space:nowrap;letter-spacing:0;text-shadow:none!important}
.car-specs{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin:2px 0 8px;width:100%}
.car-spec{display:inline-flex;flex-direction:column;align-items:center;gap:1px;min-width:64px;padding:5px 9px;border-radius:12px;background:rgba(255,255,255,.07);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
.car-spec small{font-size:9.5px;color:#b8c9e8}
.car-spec b{font-size:11.5px;font-weight:700;color:#fff;white-space:nowrap}

#END
